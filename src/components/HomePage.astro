---
import Base from '../layouts/Base.astro';
import Preloader from '../sections/home/Preloader.astro';
import Hero from '../sections/home/Hero.astro';
import Why from '../sections/home/Why.astro';
import Services from '../sections/home/Services.astro';
import Feature from '../sections/home/Feature.astro';
import Doctor from '../sections/home/Doctor.astro';
import Ask from '../sections/home/Ask.astro';
import '../sections/home/home.css';
import type { Locale } from '../i18n';

// Home page, built on the Dantora reference (see DESIGN.md): particle molar hero, statement, services
// rail, opening photo with the doctor in figures, the doctor, and a message form. Each part lives in
// src/sections/home/.
interface Props { lang: Locale }
const { lang } = Astro.props;
---

<Base lang={lang}>
  <Preloader lang={lang} />
  <Hero lang={lang} />
  <Why lang={lang} />
  <Services lang={lang} />
  <Feature lang={lang} />
  <Doctor lang={lang} />
  <Ask lang={lang} />
</Base>

<script>
  import { initHome } from '../sections/home/home';
  initHome();
</script>
