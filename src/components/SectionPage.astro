---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import About from '../sections/about/About.astro';
import Services from '../sections/services/Services.astro';
import Gallery from '../sections/gallery/Gallery.astro';
import Diplomas from '../sections/diplomas/Diplomas.astro';
import Education from '../sections/education/Education.astro';
import Tutorials from '../sections/tutorials/Tutorials.astro';
import Contact from '../sections/contact/Contact.astro';
import Articles from '../sections/articles/Articles.astro';
import { getDictionary, localeUrl, sectionUrl, isHidden, type Locale, type SectionId } from '../i18n';
import { breadcrumb, faqPage, libraryList } from '../lib/seo';
import { getPages } from '../content';
import { libraryUi } from '../content/library-ui';

// One menu page: animated title + the section's own colour sheets.
interface Props { lang: Locale; section: SectionId }
const { lang, section } = Astro.props;
const t = getDictionary(lang);
const pages = getPages(lang);
const lead = pages[section].lead;
const seo = pages.seo[section];
const schema: Record<string, unknown>[] = [
  breadcrumb([{ name: 'SaySmile', path: localeUrl(lang) }, { name: t.nav[section], path: sectionUrl(lang, section) }], Astro.site!),
];
if (section === 'services') schema.push(faqPage(pages.faq.items));
if (section === 'articles') schema.push(libraryList(lang, libraryUi[lang].title, sectionUrl(lang, 'articles'), Astro.site!));
---

<Base lang={lang} path={`${section}/`} current={section} title={seo.title} description={seo.description} schema={schema} noindex={isHidden(lang, section)}>
  <PageHero lang={lang} title={t.nav[section]} lead={lead} />
  {section === 'about' && <About lang={lang} />}
  {section === 'services' && <Services lang={lang} />}
  {section === 'gallery' && <Gallery lang={lang} />}
  {section === 'diplomas' && <Diplomas lang={lang} />}
  {section === 'education' && <Education lang={lang} />}
  {section === 'articles' && <Articles lang={lang} />}
  {section === 'tutorials' && <Tutorials lang={lang} />}
  {section === 'contact' && <Contact lang={lang} />}
</Base>
