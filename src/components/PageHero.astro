---
// Opening of every menu page: big animated title over a drifting colour field.
import { localeUrl, type Locale } from '../i18n';

interface Props { lang: Locale; title: string; lead?: string; back?: { href: string; label: string }; small?: boolean }
const { lang, title, lead, back, small = false } = Astro.props;
const tooth = 'M10 22c0-8 5-12 10-12 2 0 3 1 4 1s2-1 4-1c5 0 10 4 10 12 0 6-2 8-3 14-.5 3-1.5 4-3 4s-2-3-3-8c-.5-2-1.5-3-5-3s-4.5 1-5 3c-1 5-1.5 8-3 8s-2.5-1-3-4c-1-6-3-8-3-14z';
---

<header class:list={['phero', 'grain', { 'phero--small': small }]}>
  <span class="orb orb--a" aria-hidden="true" data-mdepth="0.9"></span>
  <span class="orb orb--b" aria-hidden="true" data-mdepth="1.6"></span>
  <span class="orb orb--c" aria-hidden="true" data-mdepth="2.4"></span>
  {[['t1', 1.2], ['t2', 2], ['t3', 0.7]].map(([c, d]) => (
    <svg class:list={['tooth', c as string]} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-mdepth={d}>
      <path d={tooth} />
    </svg>
  ))}
  <span class="ghost" aria-hidden="true"><span data-parallax="0.35">{title}</span></span>

  <div class="container phero__in">
    {back ? (
      <a class="crumbs" href={back.href} data-reveal>← {back.label}</a>
    ) : (
      <nav class="crumbs" aria-label="breadcrumb" data-reveal><a href={localeUrl(lang)}>SaySmile</a><span aria-hidden="true">/</span><span>{title}</span></nav>
    )}
    <h1 class="phero__title" data-split={small ? undefined : 'chars'}>{title}</h1>
    {lead && <p class="phero__lead" data-reveal data-delay="0.3">{lead}</p>}
  </div>
</header>

<style>
  .phero {
    position: relative; overflow: clip; color: var(--hero-ink);
    padding-top: calc(var(--header-h) + clamp(3.5rem, 9vw, 6.5rem));
    padding-bottom: calc(var(--sheet-r) + clamp(2.5rem, 6vw, 4.5rem));
    background:
      radial-gradient(90% 120% at 100% 0%, var(--hero-a) 0%, transparent 60%),
      linear-gradient(160deg, var(--hero-b) 0%, #7a604d 100%);
    animation: shift 14s ease-in-out infinite alternate;
    background-size: 140% 140%, 100% 100%;
  }
  :global(:root[data-theme='dark']) .phero { background: radial-gradient(90% 120% at 100% 0%, #3a3330 0%, transparent 60%), linear-gradient(160deg, #1a201c 0%, #0f1210 100%); }
  @keyframes shift { to { background-position: 30% 40%, 0 0; } }
  .orb--a { width: 34rem; height: 34rem; inset-block-start: -12rem; inset-inline-end: -8rem; background: radial-gradient(circle at 35% 35%, var(--accent), transparent 66%); }
  .orb--b { width: 16rem; height: 16rem; inset-block-end: 3rem; inset-inline-start: 38%; background: radial-gradient(circle at 40% 40%, #e3ecdf, var(--accent) 70%, transparent 71%); opacity: 0.28; }
  .orb--c { width: 6rem; height: 6rem; inset-block-start: 38%; inset-inline-end: 22%; border: 2px solid rgb(178 201 171 / 0.7); background: none; filter: none; opacity: 0.8; }
  .tooth { position: absolute; color: rgb(242 247 240 / 0.34); pointer-events: none; animation: bob 7s ease-in-out infinite; }
  .t1 { width: 7rem; inset-block-start: 22%; inset-inline-end: 12%; }
  .t2 { width: 3.5rem; inset-block-end: 26%; inset-inline-end: 34%; animation-delay: -2s; }
  .t3 { width: 5rem; inset-block-start: 18%; inset-inline-start: 46%; animation-delay: -4s; rotate: -14deg; }
  @keyframes bob { 50% { translate: 0 -14px; rotate: 6deg; } }
  .ghost { position: absolute; inset-inline: 0; inset-block-end: calc(var(--sheet-r) * 0.2); z-index: 0; white-space: nowrap; overflow: hidden; direction: ltr; pointer-events: none; }
  .ghost span { display: block; font-size: clamp(5rem, 14vw, 12rem); font-weight: 800; letter-spacing: -0.06em; line-height: 0.85; color: transparent; -webkit-text-stroke: 2px rgb(242 247 240 / 0.14); padding-inline: 1rem; }
  .phero__in { position: relative; z-index: 2; display: grid; gap: 1.1rem; justify-items: start; }
  .crumbs { display: inline-flex; gap: 0.6rem; align-items: center; font-size: 0.92rem; font-weight: 600; opacity: 0.85; }
  .crumbs a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: transparent; transition: text-decoration-color 0.2s; }
  .crumbs a:hover { text-decoration-color: currentColor; }
  .phero__title { margin: 0; font-size: clamp(2.2rem, 6vw, 4.6rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.98; text-wrap: balance; }
  .phero--small .phero__title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); letter-spacing: -0.03em; line-height: 1.1; max-width: 22ch; }
  html[lang='fa'] .phero__title { letter-spacing: 0; line-height: 1.35; }
  .phero__lead { margin: 0; max-width: 40rem; font-size: clamp(1.1rem, 2.2vw, 1.45rem); opacity: 0.92; }
  @media (prefers-reduced-motion: reduce) { .phero, .tooth { animation: none; } }
  @media (max-width: 640px) { .t1 { opacity: 0.5; } .t3 { display: none; } }
</style>
