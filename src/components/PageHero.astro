---
// Opening of every menu page, in the home page's language (reference: Dantora): a light field from white
// into pistachio mist, a small label with the way back, a large light title, the lead, and the particle
// molar standing at the far end (see src/sections/home/scenes.ts).
import { localeUrl, type Locale } from '../i18n';

interface Props { lang: Locale; title: string; lead?: string; back?: { href: string; label: string }; small?: boolean }
const { lang, title, lead, back, small = false } = Astro.props;
---

<header class:list={['phero', { 'phero--small': small }]}>
  <canvas class="phero__canvas" data-molar="page" data-src={`${import.meta.env.BASE_URL}models/molar.bin`} aria-hidden="true"></canvas>
  <div class="container phero__in">
    {back ? (
      <a class="crumbs" href={back.href} data-reveal>← {back.label}</a>
    ) : (
      <nav class="crumbs" aria-label="breadcrumb" data-reveal><a href={localeUrl(lang)}>SaySmile</a><span aria-hidden="true">/</span><span>{title}</span></nav>
    )}
    <h1 class="phero__title" data-split={small ? undefined : 'words'}>{title}</h1>
    {lead && <p class="phero__lead" data-reveal data-delay="0.3">{lead}</p>}
  </div>
</header>

<script>
  import { initMolars } from '../sections/home/scenes';
  initMolars();
</script>

<style>
  .phero {
    position: relative; overflow: clip; color: var(--h-ink);
    padding-top: calc(var(--header-h) + clamp(3.5rem, 9vw, 6.5rem));
    padding-bottom: calc(var(--sheet-r) + clamp(2.5rem, 6vw, 4.5rem));
    background: linear-gradient(180deg, var(--h-bg0) 0%, var(--h-bg1) 100%);
  }
  .phero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .phero__in { position: relative; z-index: 2; display: grid; gap: 1.1rem; justify-items: start; pointer-events: none; }
  .phero__in a { pointer-events: auto; }
  .crumbs { display: inline-flex; gap: 0.6rem; align-items: center; font-size: 0.74rem; font-weight: 650; letter-spacing: 0.08em; text-transform: uppercase; color: var(--h-green); }
  :global(:root[data-theme='dark']) .crumbs { color: var(--h-soft); }
  :global(html[lang='fa']) .crumbs { letter-spacing: 0; font-size: 0.86rem; }
  .crumbs a { min-height: 44px; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: transparent; transition: text-decoration-color 0.2s; }
  .crumbs a:hover { text-decoration-color: currentColor; }
  .phero__title { margin: 0; max-width: 18ch; font-size: clamp(2.2rem, 4.8vw, 3.9rem); font-weight: 350; letter-spacing: -0.025em; line-height: 1.08; text-wrap: balance; }
  .phero--small .phero__title { font-size: clamp(1.7rem, 3.6vw, 2.6rem); letter-spacing: -0.02em; line-height: 1.15; max-width: 22ch; }
  :global(html[lang='fa']) .phero__title { letter-spacing: 0; line-height: 1.35; font-weight: 500; }
  .phero__lead { margin: 0; max-width: 36rem; font-size: clamp(1.02rem, 1.8vw, 1.2rem); line-height: 1.6; color: var(--h-muted); }
  /* phones: the tooth stays at the edge, faint, so the title reads first */
  @media (max-width: 860px) { .phero__canvas { opacity: 0.4; } }
</style>
