---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getDictionary, localeUrl, sectionUrl, sectionIds, type Locale } from '../../i18n';

interface Props { lang: Locale; path?: string; current?: string }
const { lang, path = '', current = '' } = Astro.props;
const t = getDictionary(lang);
const home = localeUrl(lang);
---

<header class="header" data-header>
  <div class="header__bar">
    <a class="header__logo" href={home} aria-label="SaySmile" data-magnetic="0.2">Say<span>Smile</span></a>

    <div class="header__end">
      <nav class="header__nav" id="site-nav" aria-label={t.ui.menu}>
        {sectionIds.map((id) => (
          <a href={sectionUrl(lang, id)} aria-current={id === current ? 'page' : undefined}><span>{t.nav[id]}</span></a>
        ))}
        <div class="header__sheet-tools">
          <LangSwitcher lang={lang} path={path} />
          <ThemeToggle label={t.ui.theme} />
        </div>
      </nav>

      <div class="header__tools">
        <LangSwitcher lang={lang} path={path} />
        <ThemeToggle label={t.ui.theme} />
        <button class="header__burger" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
          <span class="sr-only">{t.ui.menu}</span>
          <i></i><i></i>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed; z-index: 50; inset-block-start: 0.75rem; inset-inline: 0;
    padding-inline: max(0.75rem, env(safe-area-inset-left, 0px));
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }
  .header.is-hidden { transform: translateY(calc(-100% - 1rem)); }
  .header__bar {
    pointer-events: auto; position: relative;
    width: min(100%, 1280px); margin-inline: auto; height: var(--header-h);
    padding-inline: 1.25rem 0.75rem; border-radius: 999px;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    color: var(--on-bar); background: color-mix(in srgb, var(--bar) 38%, transparent);
    border: 1px solid rgb(255 255 255 / 0.18);
    -webkit-backdrop-filter: blur(14px) saturate(1.3); backdrop-filter: blur(14px) saturate(1.3);
    transition: background-color 0.4s ease, box-shadow 0.4s ease;
  }
  :global([dir='rtl']) .header__bar { padding-inline: 1.25rem 0.75rem; }
  .header.is-solid .header__bar { background: color-mix(in srgb, var(--bar) 88%, transparent); box-shadow: 0 14px 34px -18px rgb(30 18 10 / 0.6); }
  .header__logo { flex: none; font-weight: 800; font-size: 1.45rem; letter-spacing: -0.04em; direction: ltr; }
  .header__logo span { color: var(--accent); }
  .header__end { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
  .header__nav { display: flex; gap: 0.1rem; font-size: 0.92rem; }
  .header__nav > a { position: relative; padding: 0.5rem 0.75rem; border-radius: 999px; white-space: nowrap; color: color-mix(in srgb, var(--on-bar) 82%, transparent); transition: color 0.25s, background-color 0.25s; }
  .header__nav > a span { position: relative; display: inline-block; }
  .header__nav > a span::after { content: ''; position: absolute; inset-inline: 0; bottom: -2px; height: 2px; border-radius: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); }
  :global([dir='rtl']) .header__nav > a span::after { transform-origin: right; }
  .header__nav > a:hover { color: var(--on-bar); }
  .header__nav > a:hover span::after { transform: scaleX(1); }
  .header__nav > a[aria-current='page'] { background: var(--accent); color: #27272a; font-weight: 650; }
  .header__nav > a[aria-current='page'] span::after { display: none; }
  .header__tools { display: flex; align-items: center; gap: 0.5rem; }
  .header__sheet-tools { display: none; }
  .header__burger { display: none; width: 44px; height: 44px; border: 1px solid rgb(255 255 255 / 0.3); border-radius: 50%; background: transparent; cursor: pointer; position: relative; }
  .header__burger i { position: absolute; inset-inline: 12px; height: 2px; background: var(--on-bar); border-radius: 2px; transition: transform 0.35s ease, top 0.35s ease; }
  .header__burger i:nth-child(2) { top: 17px; }
  .header__burger i:nth-child(3) { top: 25px; }
  :global(html.menu-open) .header__burger i:nth-child(2) { top: 21px; transform: rotate(45deg); }
  :global(html.menu-open) .header__burger i:nth-child(3) { top: 21px; transform: rotate(-45deg); }

  @media (max-width: 1180px) {
    .header__burger { display: block; }
    .header__tools > :global(.lang), .header__tools > :global(.theme-toggle) { display: none; }
    .header__sheet-tools { display: flex; gap: 0.75rem; margin-top: 1.5rem; }
    /* full-screen menu */
    .header__nav {
      position: fixed; inset: 0; z-index: -1; pointer-events: none; opacity: 0;
      flex-direction: column; justify-content: center; gap: 0.15rem; padding: 6rem 2rem 2rem;
      background: var(--deep); color: var(--on-deep); font-size: clamp(1.7rem, 7vw, 2.6rem); font-weight: 750; letter-spacing: -0.02em;
      clip-path: circle(0% at calc(100% - 3rem) 2.5rem); transition: clip-path 0.7s cubic-bezier(0.7, 0, 0.2, 1), opacity 0.2s 0.5s;
      overflow-y: auto;
    }
    :global([dir='rtl']) .header__nav { clip-path: circle(0% at 3rem 2.5rem); }
    .header__nav > a { padding: 0.35rem 0; border-radius: 0; background: none !important; color: color-mix(in srgb, var(--on-deep) 88%, transparent); transform: translateY(24px); opacity: 0; transition: transform 0.6s ease, opacity 0.6s ease, color 0.2s; }
    .header__nav > a[aria-current='page'] { color: var(--accent); }
    :global(html.menu-open) .header__nav { pointer-events: auto; opacity: 1; clip-path: circle(150% at calc(100% - 3rem) 2.5rem); transition: clip-path 0.8s cubic-bezier(0.7, 0, 0.2, 1), opacity 0s; }
    :global(html.menu-open[dir='rtl']) .header__nav { clip-path: circle(150% at 3rem 2.5rem); }
    :global(html.menu-open) .header__nav > a { transform: none; opacity: 1; }
    :global(html.menu-open) .header__nav > a:nth-child(1) { transition-delay: 0.25s; }
    :global(html.menu-open) .header__nav > a:nth-child(2) { transition-delay: 0.3s; }
    :global(html.menu-open) .header__nav > a:nth-child(3) { transition-delay: 0.35s; }
    :global(html.menu-open) .header__nav > a:nth-child(4) { transition-delay: 0.4s; }
    :global(html.menu-open) .header__nav > a:nth-child(5) { transition-delay: 0.45s; }
    :global(html.menu-open) .header__nav > a:nth-child(6) { transition-delay: 0.5s; }
    :global(html.menu-open) .header__nav > a:nth-child(7) { transition-delay: 0.55s; }
    :global(html.menu-open) .header__nav > a:nth-child(8) { transition-delay: 0.6s; }
    :global(html.menu-open) { overflow: hidden; }
    .header__burger { position: relative; z-index: 2; }
    .header__logo { position: relative; z-index: 2; }
    :global(html.menu-open) .header__bar { background: transparent; border-color: transparent; box-shadow: none; -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const root = document.documentElement;
  const set = (open: boolean) => {
    root.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => set(!root.classList.contains('menu-open')));
  document.getElementById('site-nav')?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) set(false);
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
