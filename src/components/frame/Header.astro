---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getDictionary, localeUrl, sectionIds, type Locale } from '../../i18n';

interface Props { lang: Locale; path?: string }
const { lang, path = '' } = Astro.props;
const t = getDictionary(lang);
const home = localeUrl(lang);
---

<header class="header">
  <div class="container header__bar">
    <a class="header__logo" href={home} aria-label="SaySmile">Say<span>Smile</span></a>

    <nav class="header__nav" id="site-nav" aria-label={t.ui.menu}>
      {sectionIds.map((id) => (
        <a href={`${home}#${id}`}>{t.nav[id]}</a>
      ))}
    </nav>

    <div class="header__tools">
      <LangSwitcher lang={lang} path={path} />
      <ThemeToggle label={t.ui.theme} />
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="sr-only">{t.ui.menu}</span>
        <i></i><i></i><i></i>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header__bar { height: var(--header-h); display: flex; align-items: center; gap: 1.5rem; }
  .header__logo { font-weight: 800; font-size: 1.35rem; letter-spacing: -0.02em; }
  .header__logo span { color: var(--primary); }
  .header__nav { display: flex; gap: 1.4rem; margin-inline: auto; font-size: 0.95rem; color: var(--text-muted); }
  .header__nav a { transition: color 0.2s; }
  .header__nav a:hover { color: var(--primary); }
  .header__tools { display: flex; align-items: center; gap: 0.5rem; }
  .header__burger { display: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 10px; background: transparent; cursor: pointer; padding: 10px 9px; flex-direction: column; justify-content: space-between; }
  .header__burger i { display: block; height: 2px; background: var(--text); border-radius: 2px; }

  @media (max-width: 960px) {
    .header__burger { display: flex; }
    .header__nav {
      display: none; position: absolute; inset-inline: 0; top: var(--header-h);
      flex-direction: column; gap: 0; padding: 0.5rem 1rem 1rem;
      background: var(--bg); border-bottom: 1px solid var(--line);
    }
    .header__nav a { padding: 0.8rem 0.25rem; border-bottom: 1px solid var(--line); }
    .header__nav.is-open { display: flex; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
