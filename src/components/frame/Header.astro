---
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getDictionary, localeUrl, sectionUrl, sectionIds, type Locale } from '../../i18n';

interface Props { lang: Locale; path?: string; current?: string }
const { lang, path = '', current = '' } = Astro.props;
const t = getDictionary(lang);
const home = localeUrl(lang);
---

<header class="header">
  <div class="container header__bar">
    <a class="header__logo" href={home} aria-label="SaySmile">Say<span>Smile</span></a>

    <nav class="header__nav" id="site-nav" aria-label={t.ui.menu}>
      {sectionIds.map((id) => (
        <a href={sectionUrl(lang, id)} aria-current={id === current ? 'page' : undefined}>{t.nav[id]}</a>
      ))}
    </nav>

    <div class="header__tools">
      <LangSwitcher lang={lang} path={path} />
      <ThemeToggle label={t.ui.theme} />
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="sr-only">{t.ui.menu}</span>
        <i></i><i></i><i></i>
      </button>
    </div>
  </div>
</header>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: var(--bar); color: var(--on-bar); }
  .header__bar { height: var(--header-h); display: flex; align-items: center; gap: 1.25rem; }
  .header__logo { font-weight: 800; font-size: 1.4rem; letter-spacing: -0.03em; direction: ltr; }
  .header__logo span { color: var(--accent); }
  .header__nav { display: flex; gap: 0.25rem; margin-inline: auto; font-size: 0.95rem; }
  .header__nav a { padding: 0.45rem 0.8rem; border-radius: 999px; color: color-mix(in srgb, var(--on-bar) 78%, transparent); transition: background-color 0.2s, color 0.2s; }
  .header__nav a:hover { color: var(--on-bar); background: rgb(255 255 255 / 0.1); }
  .header__nav a[aria-current='page'] { background: var(--accent); color: #27272a; font-weight: 600; }
  .header__tools { display: flex; align-items: center; gap: 0.5rem; }
  .header__burger { display: none; width: 40px; height: 40px; border: 1px solid rgb(255 255 255 / 0.3); border-radius: 10px; background: transparent; cursor: pointer; padding: 10px 9px; flex-direction: column; justify-content: space-between; }
  .header__burger i { display: block; height: 2px; background: var(--on-bar); border-radius: 2px; }

  @media (max-width: 1100px) {
    .header__burger { display: flex; }
    .header__nav {
      display: none; position: absolute; inset-inline: 0; top: var(--header-h);
      flex-direction: column; gap: 0; padding: 0.5rem 1rem 1rem;
      background: var(--bar); border-top: 1px solid rgb(255 255 255 / 0.12);
    }
    .header__nav a { padding: 0.85rem 0.5rem; border-radius: 10px; }
    .header__nav.is-open { display: flex; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
