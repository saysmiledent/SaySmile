---
import { site, contactLinks } from '../../config/site';
import { getDictionary, localeUrl, sectionUrl, sectionIds, type Locale } from '../../i18n';
import { getPages } from '../../content';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDictionary(lang);
const p = getPages(lang);
const links = contactLinks();
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <a class="footer__brand" href={localeUrl(lang)}>Say<span>Smile</span></a>
      <p class="footer__muted">{t.hero.subtitle}</p>
      <p class="footer__muted">{p.contact.address}</p>
    </div>

    <nav class="footer__col" aria-label={t.ui.menu}>
      {sectionIds.map((id) => <a href={sectionUrl(lang, id)}>{t.nav[id]}</a>)}
    </nav>

    <div class="footer__col">
      {links.map((l) => (
        <a href={l.href} rel="noopener" target={l.id === 'phone' || l.id === 'email' ? undefined : '_blank'}>
          {t.contactLabels[l.id]}
        </a>
      ))}
      <a href={site.instagram} rel="noopener" target="_blank">Instagram</a>
    </div>
  </div>
  <div class="container footer__bottom">
    <p class="footer__disc">{t.footer.disclaimer}</p>
    <small>© {new Date().getFullYear()} <bdi>SaySmile</bdi> · {t.footer.rights}</small>
  </div>
</footer>

<style>
  .footer { background: var(--bar); color: var(--on-bar); padding-top: 3rem; }
  .footer__grid { display: grid; gap: 2rem; grid-template-columns: 1.4fr 1fr 1fr; }
  .footer__brand { display: inline-block; font-weight: 800; font-size: 1.5rem; letter-spacing: -0.03em; direction: ltr; }
  .footer__brand span { color: var(--accent); }
  .footer__muted { margin: 0.25rem 0 0; color: color-mix(in srgb, var(--on-bar) 70%, transparent); }
  .footer__col { display: flex; flex-direction: column; gap: 0.5rem; color: color-mix(in srgb, var(--on-bar) 78%, transparent); }
  .footer__col a:hover { color: var(--accent); }
  .footer__bottom { margin-top: 2.5rem; padding-block: 1.25rem; border-top: 1px solid rgb(255 255 255 / 0.15); color: color-mix(in srgb, var(--on-bar) 65%, transparent); }
  .footer__disc { margin: 0 0 0.5rem; font-size: 0.9rem; }
  @media (max-width: 720px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
