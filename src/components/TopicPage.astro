---
// One tutorial topic (Farsi): reel, slides, FAQ and the research articles behind it, all linked.
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import EvidenceMark from './EvidenceMark.astro';
import { getPages } from '../content';
import { getDictionary, localeUrl, sectionUrl } from '../i18n';
import { contactLinks } from '../config/site';
import { breadcrumb, topicSchema } from '../lib/seo';
import { topicLibrary, topics, type Topic } from '../content/topics';
import { categories } from '../content/library-ui';

interface Props { topic: Topic }
const { topic: t } = Astro.props;
const lang = 'fa' as const;
const dict = getDictionary(lang);
const p = getPages(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site!;
const fa = (n: number) => n.toLocaleString('fa-IR', { useGrouping: false });
const book = contactLinks()[0];
const related = topicLibrary(t);
const cat = categories.find((c) => c.id === t.cat)!.label[lang];
const others = topics.filter((x) => x.id !== t.id);
const path = `tutorials/${t.id}/`;
const nn = (i: number) => String(i + 1).padStart(2, '0');
const schema = [
  breadcrumb([
    { name: 'SaySmile', path: localeUrl(lang) },
    { name: dict.nav.tutorials, path: sectionUrl(lang, 'tutorials') },
    { name: t.short, path: localeUrl(lang, path) },
  ], origin),
  ...topicSchema(t, origin),
];
---

<Base
  lang={lang} path={path} current="tutorials" title={t.title} description={t.description}
  ogType="article" published={t.iso} schema={schema}
  image={`og/${t.id}.jpg`} imageAlt={t.title} video={{ path: `videos/${t.id}.mp4`, width: 720, height: 1280 }}
>
  <PageHero lang={lang} small title={t.title} lead={t.lead} back={{ href: sectionUrl(lang, 'tutorials'), label: dict.nav.tutorials }} />

  <section class="sheet" aria-labelledby="reel-h">
    <div class="container reel">
      <video controls preload="none" playsinline width="720" height="1280" poster={`${base}/videos/${t.id}.jpg`} aria-label={t.reel.alt}>
        <source src={`${base}/videos/${t.id}.mp4`} type="video/mp4" />
      </video>
      <div class="reel__text">
        <h2 id="reel-h">ویدیوی کوتاه ({fa(t.reel.seconds)} ثانیه)</h2>
        <p>{t.reel.summary}</p>
        <ol class="stages" aria-label="مراحل نشان‌داده‌شده در ویدیو">
          {t.reel.stages.map((s) => <li><b>{s.when}</b><span>{s.what}</span></li>)}
        </ol>
        <p class="links">
          <a class="btn" href={t.reel.instagram} target="_blank" rel="noopener">دیدن ریل در اینستاگرام</a>
          {t.carouselInstagram && <a class="btn btn--light" href={t.carouselInstagram} target="_blank" rel="noopener">دیدن پست اسلایدی در اینستاگرام</a>}
        </p>
        <p class="tags"><span class="tag">{cat}</span>{t.tags.map((x) => <span class="tag tag--q">{x}</span>)}</p>
      </div>
    </div>
  </section>

  <section class="sheet sheet--b grain" aria-labelledby="slides-h">
    <div class="container">
      <h2 class="sec-title" id="slides-h">قدم‌به‌قدم، {fa(t.slides.length)} اسلاید</h2>
      <p class="sub">همان اسلایدهای اینستاگرام، با متن کامل زیر هر کدام. با انگشت به چپ و راست بکشید یا از فلش‌ها استفاده کنید. مرحله‌های ۴ تا ۷ خودکار و بی‌صدا پخش می‌شوند.</p>

      <div class="slider" data-slider>
        <div class="slider__stage">
          <button class="slider__arrow slider__arrow--prev" type="button" data-prev aria-label="اسلاید قبلی">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </button>
          <div class="slider__track" data-track tabindex="0" role="region" aria-roledescription="کاروسل" aria-label={`اسلایدهای ${t.short}`}>
            {t.slides.map((s, i) => (
              <article class="slide" id={`slide-${i + 1}`} data-slide aria-roledescription="اسلاید" aria-label={`${fa(i + 1)} از ${fa(t.slides.length)}`}>
                {s.motion ? (
                  <div class="slide__media">
                    <video autoplay muted loop playsinline disablepictureinpicture preload="auto" data-loop width="720" height="900" poster={`${base}/videos/${t.id}/s${nn(i)}.webp`} aria-label={s.alt}>
                      <source src={`${base}/videos/${t.id}/s${nn(i)}.mp4`} type="video/mp4" />
                    </video>
                    <button class="slide__play" type="button" data-play hidden aria-label="پخش ویدیوی این مرحله">
                      <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                    </button>
                  </div>
                ) : (
                  <img src={`${base}/videos/${t.id}/s${nn(i)}.webp`} alt={s.alt} width="1080" height="1350" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                )}
                <div class="slide__body">
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </article>
            ))}
          </div>
          <button class="slider__arrow slider__arrow--next" type="button" data-next aria-label="اسلاید بعدی">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </button>
        </div>
        <div class="slider__nav">
          <p class="slider__count" aria-live="polite"><span data-cur>{fa(1)}</span> از {fa(t.slides.length)}</p>
          <div class="slider__dots">
            {t.slides.map((s, i) => <button type="button" data-dot={i} aria-label={`اسلاید ${fa(i + 1)}: ${s.title}`}></button>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sheet" aria-labelledby="faq-h">
    <div class="container narrow">
      <h2 class="sec-title" id="faq-h">پرسش‌های رایج</h2>
      <div class="faq">
        {t.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sheet sheet--c grain" aria-labelledby="rel-h">
    <div class="container">
      <h2 class="sec-title" id="rel-h">مقاله‌های پژوهشی مرتبط</h2>
      <p class="sub">هر مقاله بازگویی ساده‌ای از یک پژوهش منتشرشده است، با لینک به متن اصلی در PubMed.</p>
      <ul class="rel">
        {related.map((e) => (
          <li data-reveal>
            <a href={localeUrl(lang, `articles/${e.slug}/`)}>
              <span class="rel__ev"><EvidenceMark type={e.type} lang={lang} /></span>
              <strong>{e.fa.title}</strong>
              <span class="rel__sum">{e.fa.sum}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="rel__all"><a href={`${sectionUrl(lang, 'articles')}#library`}>همهٔ مقاله‌های کتابخانه</a></p>
    </div>
  </section>

  <section class="sheet" aria-label="رزرو نوبت">
    <div class="container narrow end">
      <p>اگر لثه‌تان خون می‌آید یا نخ کشیدن برایتان سخت است، برای معاینه و راهنمایی شخصی بنویسید.</p>
      {book && <p><a class="btn" href={book.href} target="_blank" rel="noopener">{dict.hero.cta}</a></p>}
      {others.length > 0 && (
        <p class="more">ویدیوهای دیگر:
          {others.map((o) => <a href={localeUrl(lang, `tutorials/${o.id}/`)}>{o.title}</a>)}
        </p>
      )}
      <p class="disc">این مطلب آموزشی است و جایگزین مشاورهٔ پزشکی نیست. درمان‌ها موارد منع مصرف دارند و مشاوره با دندانپزشک لازم است.</p>
    </div>
  </section>
</Base>

<script>
  // Slide carousel: swipe (native scroll-snap) or arrows/keys; step clips play only for the slide in view.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const cur = root.querySelector<HTMLElement>('[data-cur]')!;
    const fa = (n: number) => n.toLocaleString('fa-IR', { useGrouping: false });
    let active = 0;
    let visible = true;

    const clips = slides.map((sl) => sl.querySelector<HTMLVideoElement>('video'));
    // Some phones (battery saver, in-app browsers) refuse autoplay: then a clear play button appears on that clip.
    const showPlay = (v: HTMLVideoElement, on: boolean) => {
      const btn = v.parentElement?.querySelector<HTMLButtonElement>('[data-play]');
      if (btn) btn.hidden = !on;
    };
    const tryPlay = (v: HTMLVideoElement) => {
      v.muted = true; v.defaultMuted = true;
      v.play().then(() => showPlay(v, false)).catch((err: DOMException) => {
        // AbortError = we paused it a moment later on purpose; only a refusal needs the button
        if (err && err.name === 'NotAllowedError') showPlay(v, true);
      });
    };
    const sync = () => {
      clips.forEach((v, i) => {
        if (!v) return;
        // people who asked for less motion get no autoplay, only a clear play button on the slide in view
        if (reduce) { v.pause(); showPlay(v, i === active && v.paused); return; }
        if (i === active && visible && !document.hidden) { if (v.paused) tryPlay(v); }
        else { v.pause(); showPlay(v, false); }
      });
    };
    clips.forEach((v) => {
      if (!v) return;
      if (reduce) { v.removeAttribute('autoplay'); v.pause(); }
      v.addEventListener('canplay', () => sync());
      v.addEventListener('playing', () => showPlay(v, false));
      v.parentElement?.querySelector('[data-play]')?.addEventListener('click', () => { v.play().then(() => showPlay(v, false)).catch(() => { v.controls = true; }); });
    });
    // a touch or click anywhere in the slider counts as a gesture: retry a refused clip
    root.addEventListener('pointerup', () => sync());
    document.addEventListener('visibilitychange', sync);
    let idle = 0;
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      dots.forEach((d, k) => d.toggleAttribute('aria-current', k === i));
      cur.textContent = fa(i + 1);
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      // wake the neighbours' pictures and clips so the next swipe is instant
      [i + 1].forEach((k) => slides[k]?.querySelectorAll('img').forEach((im) => { im.loading = 'eager'; }));
      sync();
    };
    // direction-safe: move by the measured distance, whatever the writing direction
    const go = (i: number, smooth = true) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      const t = track.getBoundingClientRect();
      const s = slides[n].getBoundingClientRect();
      const far = Math.abs(n - active) > 1;
      // snap-stop would make a long jump halt at every slide: pause snapping for it, then restore
      if (far) track.style.scrollSnapType = 'none';
      track.scrollBy({ left: s.left - t.left - (t.width - s.width) / 2, behavior: smooth && !reduce ? 'smooth' : 'auto' });
      if (far) setTimeout(() => { track.style.scrollSnapType = ''; }, smooth && !reduce ? 900 : 60);
    };
    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const t = track.getBoundingClientRect();
        const mid = t.left + t.width / 2;
        let best = 0, dist = Infinity;
        slides.forEach((sl, i) => {
          const r = sl.getBoundingClientRect();
          const d = Math.abs(r.left + r.width / 2 - mid);
          if (d < dist) { dist = d; best = i; }
        });
        setActive(best);
      });
      // when the swipe has settled, make sure the slide now in view is the one playing
      clearTimeout(idle);
      idle = window.setTimeout(sync, 160);
    }, { passive: true });
    prev.addEventListener('click', () => go(active - 1));
    next.addEventListener('click', () => go(active + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (e) => {
      // arrows follow the screen: right/left swap in right-to-left pages
      const rtl = getComputedStyle(track).direction === 'rtl';
      const fwd = rtl ? 'ArrowLeft' : 'ArrowRight';
      const back = rtl ? 'ArrowRight' : 'ArrowLeft';
      if (e.key === fwd) { e.preventDefault(); go(active + 1); }
      else if (e.key === back) { e.preventDefault(); go(active - 1); }
      else if (e.key === 'Home') { e.preventDefault(); go(0); }
      else if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.35 }).observe(root);
    }
    // a link like #slide-5 opens that slide
    const fromHash = () => { const m = /^#slide-(\d+)$/.exec(location.hash); if (m) go(Number(m[1]) - 1, false); };
    addEventListener('hashchange', fromHash);
    active = -1; setActive(0); fromHash();
  });
</script>

<style>
  .reel { display: grid; gap: clamp(1.5rem, 4vw, 3rem); grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); align-items: start; }
  .reel video { inline-size: 100%; aspect-ratio: 9 / 16; max-block-size: 36rem; object-fit: cover; background: #141815; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .reel__text { display: grid; gap: 1rem; align-content: start; min-inline-size: 0; }
  .reel__text h2 { font-size: clamp(1.4rem, 3vw, 2rem); margin: 0; }
  .reel__text p { margin: 0; color: var(--text-muted); max-inline-size: 60ch; }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-inline-start: 3px solid var(--accent); }
  .stages li { display: flex; gap: 0.9rem; flex-wrap: wrap; align-items: baseline; padding: 0.55rem 1.1rem; }
  .stages b { color: var(--primary); min-inline-size: 7.5rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag--q { background: transparent; border: 1px solid var(--line); color: var(--text-muted); font-weight: 500; }

  .sec-title { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 0 0 0.75rem; }
  .sub { color: var(--text-muted); max-inline-size: 62ch; margin: 0 0 2rem; }
  .sheet--c .sub { color: inherit; opacity: 0.85; }

  .slider { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; justify-items: center; }
  .slider__stage { position: relative; min-inline-size: 0; inline-size: min(100%, 27rem); }
  .slider__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; border-radius: var(--radius-lg); box-shadow: var(--shadow); background: var(--surface); border: 1px solid var(--line); }
  .slider__track::-webkit-scrollbar { display: none; }
  .slider__track:focus-visible { outline-offset: 4px; }
  .slide { flex: 0 0 100%; min-inline-size: 0; scroll-snap-align: center; scroll-snap-stop: always; display: grid; align-content: start; }
  .slide img, .slide video { inline-size: 100%; block-size: auto; aspect-ratio: 4 / 5; object-fit: cover; background: var(--bg-soft); -webkit-user-drag: none; user-select: none; }
  .slide__body { padding: 1rem 1.25rem 1.4rem; display: grid; gap: 0.3rem; }
  .slide h3 { margin: 0; font-size: 1.15rem; line-height: 1.5; }
  .slide__body p { margin: 0; color: var(--text-muted); font-size: 0.97rem; }

  .slide__media { position: relative; }
  .slide__play { position: absolute; inset-block-end: 1rem; inset-inline-end: 1rem; inline-size: 3.5rem; block-size: 3.5rem; border: 0; border-radius: 50%; background: var(--primary); color: var(--on-primary); display: grid; place-items: center; cursor: pointer; box-shadow: var(--shadow); }
  .slide__play[hidden] { display: none; }
  .slider__arrow { display: none; position: absolute; top: 40%; translate: 0 -50%; inline-size: 3rem; block-size: 3rem; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); color: var(--text); box-shadow: var(--shadow); cursor: pointer; place-items: center; transition: background-color 0.2s, opacity 0.2s; z-index: 2; }
  .slider__arrow:hover:not(:disabled) { background: var(--accent); color: #27272a; }
  .slider__arrow:disabled { opacity: 0.35; cursor: default; }
  .slider__arrow--prev { inset-inline-start: -4rem; }
  .slider__arrow--next { inset-inline-end: -4rem; }
  /* chevrons point the way the page reads: prev toward the start side, next toward the end side */
  :global([dir='rtl']) .slider__arrow--next svg { transform: scaleX(-1); }
  :global([dir='ltr']) .slider__arrow--prev svg { transform: scaleX(-1); }
  @media (hover: hover) and (pointer: fine) { .slider__arrow { display: grid; } }
  @media (hover: hover) and (pointer: fine) and (max-width: 560px) { .slider__arrow--prev { inset-inline-start: 0.5rem; } .slider__arrow--next { inset-inline-end: 0.5rem; } }

  .slider__nav { display: grid; gap: 0.25rem; justify-items: center; }
  .slider__count { margin: 0; font-weight: 650; color: var(--text-muted); font-size: 0.95rem; }
  .slider__dots { display: flex; flex-wrap: wrap; justify-content: center; }
  .slider__dots button { inline-size: 1.75rem; block-size: 2.75rem; border: 0; background: none; cursor: pointer; display: grid; place-items: center; padding: 0; }
  .slider__dots button::before { content: ''; inline-size: 0.6rem; block-size: 0.6rem; border-radius: 50%; background: var(--line); border: 1px solid var(--text-muted); transition: background-color 0.2s, scale 0.2s; }
  .slider__dots button[aria-current]::before { background: var(--primary); border-color: var(--primary); scale: 1.3; }

  .narrow { max-inline-size: 46rem; }
  .faq { display: grid; border-block-start: 1px solid var(--line); }
  .faq details { border-block-end: 1px solid var(--line); }
  .faq summary { cursor: pointer; padding: 1rem 0.25rem; min-block-size: 2.75rem; font-weight: 700; font-size: 1.08rem; list-style-position: inside; }
  .faq p { margin: 0 0 1.1rem; padding-inline: 0.25rem; color: var(--text-muted); }

  .rel { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .rel a { display: grid; gap: 0.45rem; align-content: start; block-size: 100%; padding: 1.2rem 1.35rem; background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: var(--radius-lg); transition: translate 0.25s, box-shadow 0.25s; }
  .rel a:hover { translate: 0 -3px; box-shadow: var(--shadow); }
  .rel strong { font-size: 1.1rem; line-height: 1.5; }
  .rel__sum { font-size: 0.93rem; color: var(--text-muted); }
  .rel__all { margin: 1.5rem 0 0; font-weight: 650; }
  .rel__all a { display: inline-flex; align-items: center; min-block-size: 2.75rem; text-decoration: underline; text-underline-offset: 3px; }

  .end { display: grid; gap: 1.25rem; justify-items: start; }
  .end p { margin: 0; }
  .more { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; align-items: center; font-weight: 650; }
  .more a { display: inline-flex; align-items: center; min-block-size: 2.75rem; text-decoration: underline; text-underline-offset: 3px; color: var(--primary); }
  .disc { font-size: 0.9rem; color: var(--text-muted); padding-block-start: 1rem; border-block-start: 1px solid var(--line); }

  @media (max-width: 760px) {
    .reel { grid-template-columns: minmax(0, 1fr); }
    .reel video { max-inline-size: 20rem; margin-inline: auto; }
  }
</style>
