---
// Shared wrapper for every section: anchor id, spacing, title, reveal animation.
interface Props {
  id: string;
  title: string;
  soft?: boolean;
}
const { id, title, soft = false } = Astro.props;
---

<section id={id} class:list={['section', { 'section--soft': soft }]}>
  <div class="container">
    <h2 data-reveal>{title}</h2>
    <slot />
  </div>
</section>

<style>
  h2 { font-size: clamp(1.8rem, 4vw, 2.75rem); letter-spacing: -0.02em; margin-bottom: 1.5rem; }
  section { scroll-margin-top: var(--header-h); }
</style>
