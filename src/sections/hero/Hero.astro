---
// Interactive hero: the doctor's head/body turns toward the cursor (7 photo angles
// blended by mouse position), the stage tilts in 3D, soft shapes drift at different
// depths, and everything eases away on scroll. See hero.ts for the behaviour.
import { contactLinks } from '../../config/site';
import { getDictionary, type Locale } from '../../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDictionary(lang);
const primary = contactLinks()[0];

const frames = import.meta.glob('./assets/doctor-*.webp', {
  eager: true, query: '?url', import: 'default',
}) as Record<string, string>;
const url = (name: string) => frames[`./assets/doctor-${name}.webp`];

// Order matters: left -> right (yaw), then the two pitch frames.
const yaw = ['1-left2', '2-left1', '3-center', '4-right1', '5-right2'].map(url);
const pitchUp = url('pitch-up');
const pitchDown = url('pitch-down');
---

<section class="hero" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <span class="blob blob--a" data-depth="0.4"></span>
    <span class="blob blob--b" data-depth="0.8"></span>
    <span class="blob blob--c" data-depth="1.3"></span>
  </div>

  <div class="container hero__grid">
    <h1 class="hero__title" data-hero-title aria-label={t.hero.title}>
      {[...t.hero.title].map((ch) => <span class="hero__ch">{ch}</span>)}
    </h1>

    <div class="hero__stage" data-hero-stage>
      <div class="hero__tilt" data-hero-tilt>
        {yaw.map((src, i) => (
          <img class="hero__frame" data-yaw={i} src={src} alt={i === 2 ? t.hero.alt : ''} width="720" height="900" decoding="async" fetchpriority={i === 2 ? 'high' : 'low'} />
        ))}
        <img class="hero__frame" data-pitch="up" src={pitchUp} alt="" width="720" height="900" decoding="async" loading="lazy" />
        <img class="hero__frame" data-pitch="down" src={pitchDown} alt="" width="720" height="900" decoding="async" loading="lazy" />
      </div>
      <span class="hero__shadow" aria-hidden="true"></span>
    </div>

    <div class="hero__copy" data-hero-copy>
      <span class="tag">St. Petersburg · GAM Clinic</span>
      <p class="hero__sub">{t.hero.subtitle}</p>
      {primary && <a class="btn" href={primary.href} target="_blank" rel="noopener">{t.hero.cta}</a>}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: clip;
    min-height: calc(100svh - var(--header-h));
    display: grid; align-items: end;
    background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
  }
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .blob { position: absolute; border-radius: 50%; filter: blur(2px); will-change: transform; }
  .blob--a { width: 34vmax; height: 34vmax; inset-block-start: -8%; inset-inline-start: -8%; background: radial-gradient(circle at 30% 30%, var(--accent), transparent 70%); opacity: 0.55; }
  .blob--b { width: 26vmax; height: 26vmax; inset-block-end: 4%; inset-inline-end: -6%; background: radial-gradient(circle at 60% 40%, var(--primary), transparent 70%); opacity: 0.28; }
  .blob--c { width: 9vmax; height: 9vmax; inset-block-start: 22%; inset-inline-end: 24%; background: radial-gradient(circle at 40% 40%, var(--accent), var(--primary)); opacity: 0.35; }

  .hero__grid {
    position: relative; display: grid; align-items: end; justify-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: 1.5rem 0;
  }
  .hero__title {
    position: absolute; inset-inline: 0; top: 12%; margin: 0; text-align: center;
    font-size: clamp(4.2rem, 17vw, 15rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.9;
    color: color-mix(in srgb, var(--primary) 24%, transparent);
    direction: ltr; user-select: none; z-index: 0;
  }
  .hero__ch { display: inline-block; will-change: transform; }

  .hero__stage {
    position: relative; z-index: 1;
    height: min(78svh, 820px); aspect-ratio: 720 / 900;
    perspective: 1100px;
  }
  .hero__tilt { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .hero__frame {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    opacity: 0; pointer-events: none; user-select: none;
    filter: drop-shadow(0 24px 30px rgb(39 39 42 / 0.22));
  }
  /* pitch frames only blend the head/shoulders, so arms never ghost */
  .hero__frame[data-pitch] {
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 34%, transparent 52%);
    mask-image: linear-gradient(to bottom, #000 0, #000 34%, transparent 52%);
  }
  .hero__frame[data-yaw='2'] { opacity: 1; } /* centre frame visible before JS runs */
  .hero__shadow {
    position: absolute; inset-inline: 10%; bottom: -2%; height: 8%;
    background: radial-gradient(closest-side, rgb(39 39 42 / 0.28), transparent);
    filter: blur(6px);
  }

  .hero__copy {
    position: absolute; z-index: 2; inset-inline-start: 1rem; bottom: 12%;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; max-width: 22rem;
  }
  .hero__sub { margin: 0; font-size: clamp(1.1rem, 2.2vw, 1.5rem); color: var(--text); font-weight: 500; }

  @media (max-width: 760px) {
    .hero__title { top: 6%; }
    .hero__stage { height: min(60svh, 560px); }
    .hero__copy {
      position: relative; inset: auto; align-items: center; text-align: center;
      max-width: none; padding-block: 0.5rem 2.5rem; margin-top: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) { .hero__ch { transform: none !important; } }
</style>

<script>
  import { initHero } from './hero';
  initHero();
</script>
