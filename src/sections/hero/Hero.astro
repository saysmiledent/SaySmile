---
// Home hero: the brand word read as a sentence, "Say [sculpture] Smile".
// Between the two words a few thousand beads hold a tooth; the pointer moves them aside, and a press
// (or the Tooth / Smile switch) rebuilds them into a smile. See hero.ts and field.ts.
// The doctor's portrait lives on the About page (sections/about/Portrait.astro).
import { contactLinks } from '../../config/site';
import { getDictionary, type Locale } from '../../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDictionary(lang);
const links = contactLinks();
const primary = links[0];
const chips = links.filter((l) => l.id === 'telegram' || l.id === 'whatsapp');

// "SaySmile" -> "Say" + "Smile": the sculpture sits where the two words meet
const cut = t.hero.title.search(/(?<=[a-z])(?=[A-Z])/);
const words = cut > 0 ? [t.hero.title.slice(0, cut), t.hero.title.slice(cut)] : [t.hero.title, ''];
const shapes = [t.ui.shapeTooth, t.ui.shapeSmile];
---

<section class="hero" data-hero>
  <div class="hero__pin" data-hero-pin>
  <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>

  <div class="container hero__inner">
    <h1 class="hero__title" aria-label={t.hero.title}>
      <span class="hero__word hero__word--a" aria-hidden="true">{[...words[0]].map((ch, i) => <span class="hero__ch" style={`--k:${i - words[0].length}`}>{ch}</span>)}</span>
      <span class="hero__slot" data-hero-slot aria-hidden="true"></span>
      <span class="hero__word hero__word--b" aria-hidden="true">{[...words[1]].map((ch, i) => <span class="hero__ch" style={`--k:${i + 1}`}>{ch}</span>)}</span>
    </h1>

    <div class="hero__switch" role="group" aria-label={t.ui.shape}>
      {shapes.map((label, i) => (
        <button type="button" data-shape={i} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
      ))}
    </div>

    <div class="hero__under" data-hero-under>
      <p class="hero__who">
        <span class="hero__name">{t.hero.doctor}</span>
        <span class="hero__role">{t.hero.subtitle}</span>
      </p>
      <div class="hero__actions">
        {primary && <a class="btn btn--arrow hero__cta" href={primary.href} target="_blank" rel="noopener" data-magnetic="0.3">{t.hero.cta}</a>}
        {chips.map((c) => (
          <a class="chip" href={c.href} target="_blank" rel="noopener">{t.contactLabels[c.id]}</a>
        ))}
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  /* Why pistachio: it is the brand's lead colour, so it fills the whole first screen. Cappuccino appears twice:
     on the one action and as the warm beads inside the sculpture. */
  .hero {
    --ink: #27272a;
    --ink-soft: #3b3b40;
    --word-b: #3f5a38;
    --line-ink: rgb(39 39 42 / 0.38);
    --bead-a: #3f5a38;
    --bead-b: #846652;
    --bead-c: #ffffff;
    --slot: min(30vw, 42svh, 440px);
    position: relative; overflow: clip; color: var(--ink);
    min-height: 100svh; display: grid;
    background: linear-gradient(168deg, var(--hero-a) 0%, var(--hero-b) 46%, var(--hero-c) 100%);
  }
  :global(:root[data-theme='dark']) .hero {
    --ink: #f8fafc; --ink-soft: #dbe6d7; --word-b: #b2c9ab; --line-ink: rgb(248 250 252 / 0.45);
    --bead-a: #b2c9ab; --bead-b: #c9a690; --bead-c: #f8fafc;
  }

  /* While the page scrolls, the scene follows at 60% of the scroll (hero.ts sets --sy), so it stays in view
     and the footer sheet slides over it. That is what makes the parting word and the spreading beads visible. */
  .hero__pin { position: relative; display: grid; min-height: 100svh; translate: 0 calc(var(--sy, 0) * 1px); will-change: translate; }

  /* the beads are drawn over the whole section, so a pushed bead can fly anywhere; text stays above them */
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }

  .hero__inner {
    position: relative; z-index: 2;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding-block: calc(var(--header-h) + 1.5rem) calc(2.2rem + var(--sheet-r));
  }

  /* the one big brand word (DESIGN.md allows a single display word in the hero) */
  .hero__title {
    margin: 0; width: 100%;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    direction: ltr; user-select: none;
    font-size: clamp(3.2rem, 8vw, 7.5rem); font-weight: 800; letter-spacing: -0.055em; line-height: 1;
  }
  .hero__word { display: inline-flex; }
  .hero__word--a { justify-self: end; color: var(--ink); }
  .hero__word--b { justify-self: start; color: var(--word-b); }
  .hero__ch { display: inline-block; transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1); will-change: transform, translate; }
  /* Scroll (hero.ts sets --away 0..1): "Say" leaves to the left and "Smile" to the right, each letter a little
     further than the one before it (--k), growing and fading, so the word opens like a curtain over the footer.
     `translate` and `scale` are used so this never fights the intro animation or the pointer lift (both `transform`). */
  .hero__word { opacity: calc(1.35 - var(--away, 0) * 1.6); scale: calc(1 + var(--away, 0) * 0.35); }
  .hero__word--a { translate: calc(var(--away, 0) * -13vw) 0; transform-origin: 100% 50%; }
  .hero__word--b { translate: calc(var(--away, 0) * 13vw) 0; transform-origin: 0% 50%; }
  .hero__ch { translate: calc(var(--away, 0) * var(--k, 0) * 1.6vw) 0; }
  .hero__slot::before { opacity: calc(1 - var(--away, 0) * 1.4); }
  .hero__switch { opacity: calc(1 - var(--away, 0) * 2.2); }

  /* the place of the sculpture: a soft arch (the site's identity motif) that the word opens around.
     The slot keeps its full size from the first frame, so the beads know where to gather; only the arch
     and the two words move during the intro. */
  .hero__slot { position: relative; width: var(--slot); height: calc(var(--slot) * 1.08); margin-inline: clamp(0.6rem, 2vw, 2rem); }
  .hero__slot::before {
    content: ''; position: absolute; inset: 0;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.16));
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.7);
    animation: arch 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both;
  }
  :global(:root[data-theme='dark']) .hero__slot::before { background: linear-gradient(180deg, rgb(178 201 171 / 0.16), rgb(178 201 171 / 0.04)); box-shadow: inset 0 0 0 1.5px rgb(178 201 171 / 0.28); }
  @keyframes arch { from { transform: scaleX(0); opacity: 0; } }
  .hero__word--a { animation: part-a 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both; }
  .hero__word--b { animation: part-b 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both; }
  @keyframes part-a { from { transform: translateX(calc(var(--slot) / 2)); } }
  @keyframes part-b { from { transform: translateX(calc(var(--slot) / -2)); } }

  /* Tooth / Smile: the labelled, keyboard way to do what a press on the sculpture does */
  .hero__switch {
    position: relative; z-index: 3; margin-top: -22px;
    display: inline-flex; padding: 4px; gap: 2px; border-radius: 999px;
    background: #fafcf9; border: 1px solid rgb(63 90 56 / 0.25); box-shadow: 0 14px 26px -18px rgb(44 70 40 / 0.8);
  }
  .hero__switch button {
    min-height: 36px; min-width: 5.2rem; padding: 0.3rem 1rem; border: 0; border-radius: 999px; cursor: pointer;
    background: transparent; color: #27272a; font: inherit; font-size: 0.92rem; font-weight: 650;
    transition: background-color 0.2s, color 0.2s;
  }
  /* 44px touch target without making the pill taller */
  .hero__switch button { position: relative; }
  .hero__switch button::before { content: ''; position: absolute; inset: -6px 0; }
  .hero__switch button:hover { background: rgb(178 201 171 / 0.5); }
  .hero__switch button[aria-pressed='true'] { background: #3f5a38; color: #fff; }
  .hero__switch button:active { background: #2f4529; color: #fff; }
  :global(:root[data-theme='dark']) .hero__switch { background: #1e2420; border-color: rgb(178 201 171 / 0.3); box-shadow: none; }
  :global(:root[data-theme='dark']) .hero__switch button { color: #f8fafc; }
  :global(:root[data-theme='dark']) .hero__switch button:hover { background: rgb(178 201 171 / 0.18); }
  :global(:root[data-theme='dark']) .hero__switch button[aria-pressed='true'] { background: #b2c9ab; color: #141815; }

  .hero__under { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; margin-top: 1.4rem; text-align: center; }
  .hero__who { margin: 0; display: grid; gap: 0.1rem; }
  .hero__name { font-size: 1rem; font-weight: 600; color: var(--ink-soft); }
  .hero__role { font-size: clamp(1.25rem, 2.2vw, 1.7rem); font-weight: 750; line-height: 1.25; text-wrap: balance; }
  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.6rem; }
  /* the one cappuccino action: deep mocha keeps white text at 4.5:1 */
  .hero__cta { background: var(--primary-hover); color: #fff; box-shadow: 0 14px 26px -14px rgb(132 102 82 / 0.9); }
  .hero__cta::before { background: var(--deep); }
  .hero__cta:hover { background: var(--primary-hover); }
  :global(:root[data-theme='dark']) .hero__cta { background: #846652; color: #fff; }
  .chip { padding: 0.5rem 1.1rem; min-height: 44px; display: inline-flex; align-items: center; border-radius: 999px; border: 1.5px solid var(--line-ink); background: rgb(255 255 255 / 0.4); font-size: 0.9rem; font-weight: 600; transition: background-color 0.2s, border-color 0.2s; }
  .chip:hover { background: #fff; border-color: #3f5a38; }
  .chip:active { background: #e3ecdf; }
  :global(:root[data-theme='dark']) .chip { background: rgb(255 255 255 / 0.04); }
  :global(:root[data-theme='dark']) .chip:hover { background: rgb(178 201 171 / 0.18); border-color: var(--accent); }
  :global(:root[data-theme='dark']) .chip:active { background: rgb(178 201 171 / 0.28); }

  @media (max-width: 860px) {
    .hero { --slot: min(70vw, 38svh, 330px); }
    /* the word stays whole on one line and the sculpture stands under it */
    .hero__title { grid-template-columns: auto auto; justify-content: center; row-gap: 1rem; font-size: clamp(3rem, 17vw, 5rem); }
    .hero__word--a, .hero__word--b { justify-self: auto; }
    .hero__slot { grid-column: 1 / -1; grid-row: 2; justify-self: center; margin-inline: 0; }
    .hero__word--a, .hero__word--b { animation: none; }
  }
  @media (max-width: 480px) {
    /* the booking button takes its own row, the two messengers share the next one */
    .hero__cta { flex: 0 0 100%; max-width: 19rem; justify-content: center; }
  }
  /* reduced motion: a still picture (hero.ts draws the shape once and stops) */
  @media (prefers-reduced-motion: reduce) {
    .hero__slot::before, .hero__word { animation: none; }
    .hero__ch { transition: none; }
  }
</style>

<script>
  import { initHero } from './hero';
  initHero();
</script>
