---
// Interactive hero. The doctor's head and shoulders follow the cursor (9 yaw frames + 1 look-down
// frame cut from the doctor's video, blended by mouse position); the stage tilts in 3D, soft shapes
// drift at different depths and the big brand name spreads on scroll. See hero.ts.
import { contactLinks } from '../../config/site';
import { getDictionary, type Locale } from '../../i18n';
import { getPages } from '../../content';
import DentalScene from './DentalScene.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getDictionary(lang);
const pages = getPages(lang);
const facts = pages.about.facts;
const links = contactLinks();
const primary = links[0];
const chips = links.filter((l) => l.id === 'telegram' || l.id === 'whatsapp');

const frames = import.meta.glob('./assets/doctor-*.webp', {
  eager: true, query: '?url', import: 'default',
}) as Record<string, string>;
const url = (name: string) => frames[`./assets/doctor-${name}.webp`];

// Order matters: left -> right (yaw 0..8, centre = 4), then the look-down frame.
const yaw = Array.from({ length: 9 }, (_, i) => url(`yaw-${i}`));
const pitchDown = url('pitch-down');

// Depth maps for the live 3D relief (see hero3d.ts)
const depthFiles = import.meta.glob('./assets/depth-*.webp', {
  eager: true, query: '?url', import: 'default',
}) as Record<string, string>;
const depth = (name: string) => depthFiles[`./assets/depth-${name}.webp`];
// Tooth outline (same path as the inner-page headers): the identity motif drifting behind the portrait
const tooth = 'M10 22c0-8 5-12 10-12 2 0 3 1 4 1s2-1 4-1c5 0 10 4 10 12 0 6-2 8-3 14-.5 3-1.5 4-3 4s-2-3-3-8c-.5-2-1.5-3-5-3s-4.5 1-5 3c-1 5-1.5 8-3 8s-2.5-1-3-4c-1-6-3-8-3-14z';
const relief = JSON.stringify({
  depth: Array.from({ length: 9 }, (_, i) => depth(`yaw-${i}`)),
  down: depth('pitch-down'),
});
---

<section class="hero" data-hero>
  <div class="hero__spot" aria-hidden="true"></div>
  <div class="hero__bg" aria-hidden="true">
    <span class="aurora aurora--a" data-depth="0.4"></span>
    <span class="aurora aurora--b" data-depth="0.8"></span>
    <span class="aurora aurora--c" data-depth="1.3"></span>
    <span class="ring ring--a" data-depth="0.6"></span>
    <span class="ring ring--b" data-depth="1.1"></span>
  </div>
  <DentalScene />
  <div class="hero__ripples" aria-hidden="true"></div>

  <button class="hero__pause" type="button" aria-pressed="false" data-pause data-label-pause={t.ui.pause} data-label-play={t.ui.play} aria-label={t.ui.pause}><i></i><i></i></button>

  <div class="container hero__grid">
    <h1 class="hero__title" data-hero-title aria-label={t.hero.title}>
      {[...t.hero.title].map((ch) => <span class="hero__ch" aria-hidden="true">{ch}</span>)}
    </h1>

    <div class="hero__copy" data-hero-copy>
      <span class="tag">{t.hero.doctor}</span>
      <p class="hero__sub">{t.hero.subtitle}</p>
      {primary && <a class="btn btn--arrow hero__cta" href={primary.href} target="_blank" rel="noopener" data-magnetic="0.3">{t.hero.cta}</a>}
      <div class="hero__chips">
        {chips.map((c) => (
          <a class="chip" href={c.href} target="_blank" rel="noopener" data-magnetic="0.25">{t.contactLabels[c.id]}</a>
        ))}
      </div>
    </div>

    <div class="hero__card" data-hero-stage>
      <div class="hero__arch">
        <div class="hero__stage" data-relief={relief}>
          <div class="hero__tilt" data-hero-tilt>
            {yaw.map((src, i) => (
              <img class="hero__frame" data-yaw={i} src={src} alt={i === 4 ? t.hero.alt : ''} width="600" height="720" decoding="async" fetchpriority={i === 4 ? 'high' : 'low'} />
            ))}
            <img class="hero__frame" data-pitch="down" src={pitchDown} alt="" width="600" height="720" decoding="async" loading="lazy" />
          </div>
        </div>
        <span class="hero__gloss" aria-hidden="true"></span>
        <span class="hero__floor" aria-hidden="true"></span>
      </div>
      {facts.slice(0, 3).map((f, i) => (
        <div class={`glass glass--${i}`} data-mdepth={1.1 + i * 0.5}>
          <b>{f.title}</b>
          <span>{f.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Why pistachio: it is the brand's lead colour, so it fills the hero; cappuccino stays on the one action (CTA) and the floor ledge. */
  .hero {
    --ink: #27272a;
    --ink-soft: #3b3b40;
    --line-ink: rgb(39 39 42 / 0.38);
    position: relative; overflow: clip; color: var(--ink);
    min-height: 100svh;
    display: grid; align-items: end;
    background:
      radial-gradient(60% 70% at 78% 12%, rgb(255 255 255 / 0.9) 0%, transparent 62%),
      radial-gradient(50% 55% at 8% 96%, rgb(242 247 240 / 0.55) 0%, transparent 70%),
      linear-gradient(162deg, var(--hero-a) 0%, var(--hero-b) 48%, var(--hero-c) 100%);
  }
  :global(:root[data-theme='dark']) .hero {
    --ink: #f8fafc; --ink-soft: #dbe6d7; --line-ink: rgb(248 250 252 / 0.45);
    background:
      radial-gradient(60% 70% at 78% 12%, rgb(178 201 171 / 0.28) 0%, transparent 62%),
      linear-gradient(162deg, var(--hero-a) 0%, var(--hero-b) 52%, var(--hero-c) 100%);
  }
  /* pointer light: a bright patch of the same pistachio that follows the cursor */
  .hero__spot { position: absolute; inset: 0; pointer-events: none; z-index: 0; background: radial-gradient(30rem circle at var(--mx, 62%) var(--my, 38%), rgb(255 255 255 / 0.55), transparent 62%); mix-blend-mode: soft-light; }
  .hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .aurora, .ring { position: absolute; border-radius: 50%; will-change: transform; }
  /* aurora drifts with CSS `translate`/`scale`, the pointer parallax in hero.ts owns `transform`, so they add up */
  .aurora--a { width: 46vmax; height: 46vmax; inset-block-start: -22%; inset-inline-end: -12%; background: radial-gradient(circle at 40% 40%, rgb(255 255 255 / 0.85), transparent 66%); animation: drift-a 16s ease-in-out infinite alternate; }
  .aurora--b { width: 36vmax; height: 36vmax; inset-block-end: -18%; inset-inline-start: -10%; background: radial-gradient(circle at 50% 50%, rgb(242 247 240 / 0.8), transparent 68%); animation: drift-b 19s ease-in-out infinite alternate; }
  /* the only warm patch: cappuccino, small and soft, so brown stays a minor accent */
  .aurora--c { width: 16vmax; height: 16vmax; inset-block-end: 6%; inset-inline-end: 30%; background: radial-gradient(circle at 50% 50%, rgb(154 123 102 / 0.38), transparent 68%); animation: drift-c 13s ease-in-out infinite alternate; }
  :global(:root[data-theme='dark']) .aurora--a { background: radial-gradient(circle at 40% 40%, rgb(178 201 171 / 0.35), transparent 66%); }
  :global(:root[data-theme='dark']) .aurora--b { background: radial-gradient(circle at 50% 50%, rgb(178 201 171 / 0.2), transparent 68%); }
  @keyframes drift-a { to { translate: -5vmax 4vmax; scale: 1.12; } }
  @keyframes drift-b { to { translate: 6vmax -3vmax; scale: 1.1; } }
  @keyframes drift-c { to { translate: -4vmax -3vmax; scale: 1.25; } }
  .ring { border: 2px solid rgb(255 255 255 / 0.75); }
  .ring--a { width: 22vmax; height: 22vmax; inset-block-start: 30%; inset-inline-start: 36%; animation: pulse 7s ease-in-out infinite; }
  .ring--b { width: 8vmax; height: 8vmax; inset-block-end: 18%; inset-inline-end: 12%; animation: pulse 5s ease-in-out infinite -2s; }
  :global(:root[data-theme='dark']) .ring { border-color: rgb(178 201 171 / 0.4); }
  @keyframes pulse { 50% { scale: 1.08; opacity: 0.55; } }

  /* click ripple (hero.ts): confirms the touch of a pointer with a short expanding ring */
  .hero__ripples { position: absolute; inset: 0; pointer-events: none; z-index: 3; overflow: hidden; }
  .hero__ripples :global(.pop) { position: absolute; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.9); background: radial-gradient(circle at 32% 28%, #fff 0 18%, rgb(255 255 255 / 0.5) 40%, rgb(255 255 255 / 0.1) 70%); }
  .hero__ripples :global(.ripple) { position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px rgb(92 122 84 / 0.35); }

  /* pause control: the scene loops longer than 5 seconds, so it can be stopped */
  .hero__pause { position: absolute; z-index: 5; inset-inline-end: 1rem; bottom: calc(var(--sheet-r) + 1rem); width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--line-ink); background: rgb(255 255 255 / 0.7); color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: background-color 0.2s, border-color 0.2s; }
  .hero__pause:hover { background: #fff; border-color: #3f5a38; }
  .hero__pause i { grid-area: 1 / 1; width: 4px; height: 14px; border-radius: 2px; background: currentColor; }
  .hero__pause i:first-child { translate: -4px 0; }
  .hero__pause i:last-child { translate: 4px 0; }
  .hero__pause[aria-pressed='true'] i:first-child { translate: 0; width: 0; height: 0; border-radius: 0; background: none; border-block: 8px solid transparent; border-inline-start: 13px solid currentColor; }
  .hero__pause[aria-pressed='true'] i:last-child { display: none; }
  :global(:root[data-theme='dark']) .hero__pause { background: rgb(255 255 255 / 0.06); }
  :global(:root[data-theme='dark']) .hero__pause:hover { background: rgb(178 201 171 / 0.2); border-color: var(--accent); }
  .hero.is-paused .aurora, .hero.is-paused .ring, .hero.is-paused .glass, .hero.is-paused .hero__gloss::after, .hero.is-paused .hero__cue span { animation-play-state: paused; }

  .hero__grid {
    position: relative; display: grid; align-items: center; gap: 2rem;
    grid-template-columns: minmax(0, 1fr) auto;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 3rem) calc(3.5rem + var(--sheet-r));
  }
  /* the brand word: glossy white lettering with a dark-green edge (edge keeps it legible on every pistachio tone) */
  .hero__title {
    position: absolute; left: 1rem; top: calc(var(--header-h) + 2.2rem); margin: 0; text-align: left;
    font-size: clamp(3.6rem, 10vw, 9.5rem); font-weight: 800; letter-spacing: -0.055em; line-height: 0.9;
    direction: ltr; user-select: none; z-index: 0;
  }
  :global([dir='rtl']) .hero__title { left: auto; right: 1rem; text-align: right; }
  .hero__ch {
    display: inline-block; will-change: transform;
    color: transparent;
    background: linear-gradient(180deg, #ffffff 0%, #ffffff 42%, #dcebd6 46%, #f2f7f0 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-stroke: 1.5px #4a6a42;
    filter: drop-shadow(0 10px 14px rgb(44 70 40 / 0.28));
  }
  :global(:root[data-theme='dark']) .hero__ch {
    background: linear-gradient(180deg, #e3ecdf 0%, #b2c9ab 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-stroke: 2px #5c7a54; filter: none;
  }

  .hero__copy {
    position: relative; z-index: 2; align-self: end; margin-bottom: 8%;
    display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; max-width: 26rem;
  }
  .hero .tag { background: rgb(255 255 255 / 0.78); color: #3f5a38; border: 1px solid rgb(255 255 255 / 0.9); box-shadow: inset 0 1px 0 #fff; }
  :global(:root[data-theme='dark']) .hero .tag { background: rgb(178 201 171 / 0.18); color: #cfe3c8; border-color: rgb(178 201 171 / 0.35); box-shadow: none; }
  .hero__sub { margin: 0; font-size: clamp(1.4rem, 2.8vw, 2.2rem); font-weight: 700; line-height: 1.25; text-wrap: balance; }
  /* the one cappuccino action: deep mocha for 4.5:1 white text, glossy lit edge, sweeps to graphite on hover */
  .hero__cta { background: var(--primary-hover); color: #fff; box-shadow: inset 0 1.5px 0 rgb(255 255 255 / 0.45), inset 0 -12px 18px -12px rgb(0 0 0 / 0.35), 0 14px 26px -14px rgb(132 102 82 / 0.9); }
  .hero__cta::before { background: var(--deep); }
  .hero__cta:hover { background: var(--primary-hover); }
  :global(:root[data-theme='dark']) .hero__cta { background: #846652; color: #fff; }
  .hero__chips { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .chip { padding: 0.5rem 1.1rem; min-height: 44px; display: inline-flex; align-items: center; border-radius: 999px; border: 1.5px solid var(--line-ink); background: rgb(255 255 255 / 0.4); font-size: 0.9rem; font-weight: 600; transition: background-color 0.2s, border-color 0.2s; }
  .chip:hover { background: #fff; border-color: #3f5a38; }
  :global(:root[data-theme='dark']) .chip { background: rgb(255 255 255 / 0.04); }
  :global(:root[data-theme='dark']) .chip:hover { background: rgb(178 201 171 / 0.18); border-color: var(--accent); }

  /* The portrait sits in its own arched frame, standing on a floor, so he never floats */
  .hero__card { position: relative; z-index: 1; }
  .hero__arch {
    position: relative; overflow: hidden;
    height: min(74svh, 780px); aspect-ratio: 600 / 720;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    background:
      radial-gradient(90% 60% at 50% 16%, rgb(255 255 255 / 0.9), transparent 70%),
      linear-gradient(180deg, #e9f2e5 0%, var(--accent) 100%);
    border: 2px solid rgb(255 255 255 / 0.95);
    box-shadow: inset 0 0 0 1px rgb(92 122 84 / 0.12), 0 40px 70px -34px rgb(44 70 40 / 0.65);
  }
  :global(:root[data-theme='dark']) .hero__arch {
    background:
      radial-gradient(90% 60% at 50% 18%, rgb(178 201 171 / 0.28), transparent 70%),
      linear-gradient(180deg, #2a322c 0%, #1e2420 100%);
    border-color: rgb(178 201 171 / 0.4);
  }
  /* glass sheen on the arch: a diagonal light band that slides with the gaze (--gx -1..1) and sweeps once in a while */
  .hero__gloss {
    position: absolute; inset: 0; z-index: 3; pointer-events: none; border-radius: inherit; overflow: hidden;
  }
  .hero__gloss::before {
    content: ''; position: absolute; inset: -10% -40%;
    background: linear-gradient(112deg, transparent calc(40% + var(--gx, 0) * 14%), rgb(255 255 255 / 0.34) calc(46% + var(--gx, 0) * 14%), rgb(255 255 255 / 0.08) calc(52% + var(--gx, 0) * 14%), transparent calc(56% + var(--gx, 0) * 14%));
    mix-blend-mode: soft-light;
  }
  .hero__gloss::after {
    content: ''; position: absolute; inset: 0 auto 0 -60%; width: 40%;
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.55), transparent);
    transform: skewX(-18deg); animation: sweep 7s ease-in-out infinite 2.4s;
  }
  @keyframes sweep { 0% { translate: 0 0; } 32%, 100% { translate: 520% 0; } }
  .hero__stage { position: absolute; inset: 0 0 6% 0; perspective: 1100px; }
  .hero__tilt { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .hero__frame {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: bottom;
    opacity: 0; pointer-events: none; user-select: none;
  }
  .hero__stage :global(.hero__gl) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  [data-hero].is-gl .hero__frame { visibility: hidden; }
  /* pitch frames only blend the head/shoulders, so the body never ghosts */
  .hero__frame[data-pitch] {
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 28%, transparent 44%);
    mask-image: linear-gradient(to bottom, #000 0, #000 28%, transparent 44%);
  }
  .hero__frame[data-yaw='4'] { opacity: 1; } /* centre frame visible before JS runs */
  /* floor: a glossy cappuccino ledge, the second (small) place the brand brown appears */
  .hero__floor {
    position: absolute; inset-inline: 0; bottom: 0; height: 9%; z-index: 2;
    background: linear-gradient(180deg, #b39581 0%, var(--primary) 38%, var(--primary-hover) 100%);
    border-top: 2px solid rgb(255 255 255 / 0.8);
    box-shadow: 0 -14px 22px -6px rgb(44 70 40 / 0.3);
  }

  /* fact cards beside the portrait: clear frosted look from a tinted gradient and lit edge (no blur, the header already uses it) */
  .glass { position: absolute; z-index: 4; width: 13.5rem; padding: 0.85rem 1.1rem; border-radius: 1.1rem; display: grid; gap: 0.15rem; font-size: 0.86rem; line-height: 1.35; color: #27272a; background: linear-gradient(140deg, rgb(255 255 255 / 0.92), rgb(255 255 255 / 0.6)); border: 1px solid #fff; box-shadow: inset 0 1px 0 #fff, 0 22px 36px -22px rgb(44 70 40 / 0.65); animation: bob-card 6s ease-in-out infinite; }
  :global(:root[data-theme='dark']) .glass { color: var(--text); background: linear-gradient(140deg, rgb(46 54 48 / 0.92), rgb(30 36 32 / 0.8)); border-color: rgb(178 201 171 / 0.3); box-shadow: 0 22px 36px -22px rgb(0 0 0 / 0.8); }
  .glass b { font-size: 0.98rem; color: #3f5a38; }
  :global(:root[data-theme='dark']) .glass b { color: #cfe3c8; }
  /* they sit beside the portrait, never on top of it */
  .glass--0 { inset-block-start: 24%; inset-inline-end: calc(100% + 1.5rem); }
  .glass--1 { inset-block-start: 49%; inset-inline-end: calc(100% + 3.5rem); animation-delay: -2s; }
  .glass--2 { inset-block-start: 74%; inset-inline-end: calc(100% + 1.5rem); animation-delay: -4s; }
  @keyframes bob-card { 50% { translate: 0 -10px; } }
  .hero__cue { position: absolute; z-index: 3; inset-inline-start: 50%; bottom: calc(var(--sheet-r) + 1.2rem); translate: -50% 0; width: 1.6rem; height: 2.6rem; border: 2px solid rgb(39 39 42 / 0.6); border-radius: 1rem; display: none; }
  .hero__cue::before { content: ''; position: absolute; inset: -16px; }
  .hero__cue span { position: absolute; left: 50%; top: 0.45rem; width: 4px; height: 8px; margin-left: -2px; border-radius: 2px; background: #27272a; animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { opacity: 0; translate: 0 0; } 30% { opacity: 1; } 100% { opacity: 0; translate: 0 14px; } }
  @media (min-width: 861px) and (min-height: 700px) { .hero__cue { display: block; } }
  @media (max-width: 1260px) { .glass { display: none; } }
  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; justify-items: center; gap: 1.1rem; padding-block: calc(var(--header-h) + 2.2rem) calc(2.5rem + var(--sheet-r)); }
    .hero__card { order: 1; }
    .hero__copy { order: 2; align-self: center; align-items: center; text-align: center; margin-bottom: 0; max-width: 30rem; }
    .hero__chips { justify-content: center; }
    .hero__title { position: static; order: 0; text-align: center; font-size: clamp(3.6rem, 21vw, 7rem); }
    :global([dir='rtl']) .hero__title { text-align: center; }
    .hero__arch { height: min(52svh, 480px); }
    .ring--b { display: none; }
  }
  /* mobile energy 1 (DESIGN.md): still background, no looping motion */
  @media (max-width: 768px) { .aurora, .ring, .hero__gloss::after { animation: none !important; } }
  @media (prefers-reduced-motion: reduce) { .hero__ch { transform: none !important; } .glass, .hero__cue span, .aurora, .ring, .hero__gloss::after { animation: none !important; } }
</style>

<script>
  import { initHero } from './hero';
  initHero();
</script>
