---
import SectionShell from '../../components/ui/SectionShell.astro';
import { contactLinks } from '../../config/site';
import { getDictionary, type Locale } from '../../i18n';
const { lang } = Astro.props as { lang: Locale };
const t = getDictionary(lang);
const links = contactLinks(); // order: Telegram, WhatsApp, email, phone
---

<SectionShell id="contact" title={t.nav.contact}>
  <div class="contact" data-reveal-group>
    {links.map((l, i) => (
      <a
        data-reveal
        class:list={['btn', { 'btn--ghost': i > 0 }]}
        href={l.href}
        target={l.id === 'phone' || l.id === 'email' ? undefined : '_blank'}
        rel="noopener"
      >
        {t.contactLabels[l.id]}
      </a>
    ))}
  </div>
</SectionShell>

<style>.contact { display: flex; flex-wrap: wrap; gap: 0.75rem; }</style>
