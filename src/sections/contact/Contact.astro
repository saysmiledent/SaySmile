---
import { getPages } from '../../content';
import { getDictionary, type Locale } from '../../i18n';
import { contactLinks, site } from '../../config/site';
const { lang } = Astro.props as { lang: Locale };
const t = getDictionary(lang);
const p = getPages(lang).contact;
const links = contactLinks(); // order: Telegram, WhatsApp, email, phone
const value: Record<string, string> = {
  telegram: '@saySmaile',
  whatsapp: '+7 952 222-24-59',
  email: site.contacts.email,
  phone: '+7 993 981-31-83',
};
const map = 'https://yandex.ru/maps/?text=' + encodeURIComponent('Лиговский пр., 232, Санкт-Петербург');
---

<div class="grid" data-reveal-group>
  {links.map((l, i) => (
    <a class:list={['card', `card--${i}`]} data-reveal href={l.href} target={l.id === 'phone' || l.id === 'email' ? undefined : '_blank'} rel="noopener">
      <span class="card__name">{t.contactLabels[l.id]}</span>
      <bdi class="card__value">{value[l.id]}</bdi>
    </a>
  ))}
</div>

<div class="info" data-reveal-group>
  <section class="box" data-reveal>
    <h2>{p.hoursTitle}</h2>
    <p>{p.hours}</p>
  </section>
  <section class="box" data-reveal>
    <h2>{p.addressTitle}</h2>
    <p>{p.address}</p>
    <a class="btn" href={map} target="_blank" rel="noopener">{p.route}</a>
  </section>
</div>

<style>
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  .card { display: grid; gap: 0.25rem; padding: 1.75rem; border-radius: var(--radius-lg); min-height: 8.5rem; align-content: end; transition: translate 0.25s ease; }
  .card:hover { translate: 0 -4px; }
  .card--0 { background: var(--primary); color: var(--on-primary); }
  .card--1 { background: var(--accent); color: #27272a; }
  .card--2, .card--3 { background: var(--surface); border: 1px solid var(--line); }
  .card__name { font-size: 0.95rem; opacity: 0.85; }
  .card__value { font-size: clamp(1.3rem, 3vw, 1.8rem); font-weight: 750; letter-spacing: -0.01em; direction: ltr; text-align: start; }
  .info { display: grid; gap: 1rem; grid-template-columns: 1fr 1.4fr; margin-top: 1rem; }
  .box { padding: 1.75rem; border-radius: var(--radius-lg); background: var(--bg-soft); border: 1px solid var(--line); }
  .box h2 { font-size: 1.25rem; }
  .box p { color: var(--text-muted); }
  @media (max-width: 720px) { .grid, .info { grid-template-columns: 1fr; } }
</style>
