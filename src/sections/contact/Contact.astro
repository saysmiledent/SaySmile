---
import { getPages } from '../../content';
import { getDictionary, type Locale } from '../../i18n';
import { contactLinks, site } from '../../config/site';
const { lang } = Astro.props as { lang: Locale };
const t = getDictionary(lang);
const p = getPages(lang).contact;
const links = contactLinks(); // order: Telegram, WhatsApp, email, phone
const value: Record<string, string> = {
  telegram: '@saySmaile',
  whatsapp: '+7 952 222-24-59',
  email: site.contacts.email,
  phone: '+7 993 981-31-83',
};
const map = 'https://yandex.ru/maps/?text=' + encodeURIComponent('Лиговский пр., 232, Санкт-Петербург');
---

<section class="sheet" aria-label={t.nav.contact}>
  <div class="container">
    <ul class="rows" data-reveal-group>
      {links.map((l, i) => (
        <li class:list={['row', { 'row--main': i === 0 }]} data-reveal>
          <a href={l.href} target={l.id === 'phone' || l.id === 'email' ? undefined : '_blank'} rel="noopener" data-cursor={t.contactLabels[l.id]}>
            <span class="row__name">{t.contactLabels[l.id]}</span>
            <bdi class="row__value">{value[l.id]}</bdi>
            <svg class="row__arrow" viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="sheet sheet--c grain" aria-label={p.addressTitle}>
  <span class="orb orb--a" aria-hidden="true" data-mdepth="1.2"></span>
  <div class="container info">
    <div class="box" data-reveal>
      <p class="eyebrow">{p.hoursTitle}</p>
      <p class="big">{p.hours}</p>
    </div>
    <div class="box" data-reveal data-delay="0.15">
      <p class="eyebrow">{p.addressTitle}</p>
      <p class="big">{p.address}</p>
      <a class="btn btn--arrow" href={map} target="_blank" rel="noopener" data-magnetic="0.3">{p.route}</a>
    </div>
  </div>
</section>

<style>
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .row { border-bottom: 1px solid var(--line); }
  .row a { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template-columns: minmax(7rem, 0.5fr) 1fr auto; align-items: center; gap: 1.5rem; padding: clamp(1.4rem, 3.6vw, 2.6rem) clamp(0.5rem, 2vw, 1.5rem); transition: color 0.4s, padding 0.4s; }
  .row a::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--accent); transform: translateY(101%); transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .row a:hover { color: #27272a; padding-inline: clamp(1rem, 3vw, 2.2rem); }
  .row a:hover::before { transform: translateY(0); }
  .row--main a { background: var(--primary); color: var(--on-primary); border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .row--main a:hover { color: #27272a; }
  .row__name { font-size: 1rem; font-weight: 650; opacity: 0.85; }
  .row__value { font-size: clamp(1.2rem, 2.8vw, 2.1rem); font-weight: 800; letter-spacing: -0.035em; direction: ltr; text-align: start; line-height: 1.1; word-break: break-word; }
  .row__arrow { transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .row a:hover .row__arrow { transform: rotate(45deg) scale(1.15); }
  [dir='rtl'] .row__value { text-align: end; justify-self: end; }
  [dir='rtl'] .row__arrow { transform: scaleX(-1); }
  [dir='rtl'] .row a:hover .row__arrow { transform: scaleX(-1) rotate(45deg) scale(1.15); }
  .orb--a { width: 30rem; height: 30rem; inset-block-start: -10rem; inset-inline-start: -8rem; background: radial-gradient(circle, rgb(255 255 255 / 0.45), transparent 65%); }
  .info { position: relative; z-index: 1; display: grid; gap: clamp(2rem, 6vw, 5rem); grid-template-columns: 1fr 1.3fr; }
  .box { display: grid; gap: 1.2rem; align-content: start; justify-items: start; }
  .big { margin: 0; font-size: clamp(1.3rem, 2.6vw, 2rem); font-weight: 750; letter-spacing: -0.03em; line-height: 1.15; text-wrap: balance; }
  html[lang='fa'] .big { line-height: 1.5; letter-spacing: 0; }
  .box .btn { background: #27272a; color: #fff; }
  @media (max-width: 760px) {
    .info { grid-template-columns: 1fr; }
    .row a { grid-template-columns: 1fr auto; }
    .row__name { grid-column: 1 / -1; }
  }
</style>
