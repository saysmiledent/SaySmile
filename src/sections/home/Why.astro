---
// Centred statement that slides over the hero. On desktop the pointer leaves a short trail of the
// doctor's own result photos (home.ts).
import { homeCopy } from './copy';
import { sectionUrl, type Locale } from '../../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const c = homeCopy[lang];
const base = import.meta.env.BASE_URL;
const trail = ['h-front-1-2', 'caries-dam-3', 'h-lower-1-2', 'h-front-4-2', 'restore-steps-4', 'h-front-3-2', 'h-lower-3-2'].map((n) => `${base}img/gallery/${n}.webp`);
---
<section class="h-why" data-h-why data-trail={JSON.stringify(trail)}>
  <div class="h-wrap h-why__inner">
    <p class="h-label" data-h-rise>{c.why.label}</p>
    <h2 class="h-why__title" data-h-lines>{c.why.title}</h2>
    <p class="h-why__text" data-h-rise>{c.why.text}</p>
    <div class="h-actions h-actions--center" data-h-rise>
      <a class="h-btn" href={sectionUrl(lang, 'about')}>{c.why.a}</a>
      <a class="h-btn h-btn--soft" href={sectionUrl(lang, 'gallery')}>{c.why.b}</a>
    </div>
  </div>
</section>
