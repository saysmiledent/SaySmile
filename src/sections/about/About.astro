---
import { getPages } from '../../content';
import type { Locale } from '../../i18n';
const { lang } = Astro.props as { lang: Locale };
const p = getPages(lang).about;
---

<div class="facts" data-reveal-group>
  {p.facts.map((f, i) => (
    <article class:list={['fact', `fact--${i % 3}`]} data-reveal>
      <h2>{f.title}</h2>
      <p>{f.text}</p>
    </article>
  ))}
</div>

<style>
  .facts { display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  .fact { padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: var(--radius-lg); min-height: 11rem; }
  .fact--0 { background: var(--accent); color: #27272a; }
  .fact--1 { background: var(--primary); color: var(--on-primary); }
  .fact--2 { background: var(--bg-soft); border: 1px solid var(--line); }
  h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  p { margin: 0; font-size: 1.1rem; max-width: 30ch; }
  @media (max-width: 720px) { .facts { grid-template-columns: 1fr; } }
</style>
