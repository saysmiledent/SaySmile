---
import { getPages } from '../../content';
import { getDictionary, type Locale } from '../../i18n';
import { contactLinks } from '../../config/site';
const { lang } = Astro.props as { lang: Locale };
const t = getDictionary(lang);
const p = getPages(lang).about;
const book = contactLinks()[0];
const frames = import.meta.glob('../hero/assets/doctor-yaw-4.webp', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const portrait = Object.values(frames)[0];
const nf = (v: number) => v.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
---

<section class="sheet" aria-label={t.nav.about}>
  <div class="container wrap">
    <aside class="who" data-reveal="clip">
      <div class="arch" data-tilt="flat">
        <img src={portrait} alt={t.hero.alt} width="600" height="720" loading="lazy" decoding="async" data-parallax="0.04" />
      </div>
      <span class="who__chip" data-mdepth="1.2">{t.hero.doctor}</span>
      <span class="who__chip who__chip--b" data-mdepth="2">{t.hero.subtitle}</span>
    </aside>

    <div class="facts" data-stack>
      {p.facts.map((f, i) => (
        <div class="stack__item" style={`--i:${i}`}>
          <article class:list={['fact', `fact--${i % 4}`]} data-tilt data-tilt-max="4">
            <h2 class="fact__title">{f.title}</h2>
            <p>{f.text}</p>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sheet sheet--d grain" aria-label={t.hero.doctor}>
  <span class="orb orb--a" aria-hidden="true" data-mdepth="1"></span>
  <div class="container statement">
    <p class="eyebrow">{t.hero.doctor}</p>
    <p class="statement__text" data-split>{p.lead}</p>
    <div class="statement__row">
      <p class="hours" aria-label="09:00–21:00">
        <span class="hours__n"><span data-counter="9">{nf(9)}</span>:{nf(0)}{nf(0)}</span>
        <span class="hours__dash" aria-hidden="true">—</span>
        <span class="hours__n"><span data-counter="21">{nf(21)}</span>:{nf(0)}{nf(0)}</span>
      </p>
      {book && <a class="btn btn--light btn--arrow" href={book.href} target="_blank" rel="noopener" data-magnetic="0.3">{t.hero.cta}</a>}
    </div>
  </div>
</section>

<style>
  .wrap { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(1.5rem, 5vw, 4.5rem); align-items: start; }
  .who { position: sticky; top: calc(var(--header-h) + 2rem); }
  .arch {
    position: relative; overflow: hidden; aspect-ratio: 600 / 720; border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    background: radial-gradient(90% 60% at 50% 18%, rgb(242 247 240 / 0.55), transparent 70%), linear-gradient(180deg, #d9e5d4, var(--accent));
    border: 1.5px solid var(--line); box-shadow: var(--shadow);
  }
  :global(:root[data-theme='dark']) .arch { background: radial-gradient(90% 60% at 50% 18%, rgb(178 201 171 / 0.22), transparent 70%), linear-gradient(180deg, #2a322c, #1e2420); }
  .arch img { width: 100%; height: 108%; object-fit: cover; object-position: top; }
  .who__chip { position: absolute; inset-block-start: 12%; inset-inline-start: 0.6rem; padding: 0.5rem 1rem; border-radius: 999px; background: var(--primary); color: var(--on-primary); font-weight: 700; font-size: 0.92rem; box-shadow: var(--shadow); }
  .who__chip--b { inset-block-start: auto; inset-block-end: 14%; inset-inline-start: auto; inset-inline-end: 0.6rem; background: var(--accent); color: #27272a; }
  .facts { display: block; }
  .stack__item { position: sticky; top: calc(var(--header-h) + 2rem + var(--i) * 1.1rem); padding-bottom: 1.5rem; }
  .fact { min-height: 15rem; padding: clamp(1.5rem, 4vw, 2.6rem); border-radius: var(--radius-lg); display: grid; align-content: space-between; gap: 1.5rem; box-shadow: var(--shadow); }
  .fact--0 { background: var(--accent); color: #27272a; }
  .fact--1 { background: var(--primary); color: var(--on-primary); }
  .fact--2 { background: var(--surface); border: 1px solid var(--line); }
  .fact--3 { background: var(--deep); color: var(--on-deep); }
  .fact__title { margin: 0; font-size: clamp(1.5rem, 2.8vw, 2.2rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  html[lang='fa'] .fact__title { line-height: 1.4; letter-spacing: 0; }
  .fact p { margin: 0; font-size: 1.15rem; max-width: 32ch; opacity: 0.92; }
  .orb--a { width: 30rem; height: 30rem; inset-block-start: -10rem; inset-inline-start: -8rem; background: radial-gradient(circle, rgb(178 201 171 / 0.45), transparent 65%); }
  .statement { position: relative; z-index: 1; display: grid; gap: 1.5rem; }
  .statement__text { margin: 0; max-width: 24ch; font-size: clamp(1.7rem, 3.6vw, 2.8rem); font-weight: 750; letter-spacing: -0.035em; line-height: 1.08; text-wrap: balance; }
  html[lang='fa'] .statement__text { line-height: 1.45; letter-spacing: 0; max-width: 22ch; }
  .statement__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 1rem; }
  .hours { margin: 0; display: flex; align-items: baseline; gap: 0.6rem; font-size: clamp(2rem, 5vw, 3.6rem); font-weight: 800; letter-spacing: -0.04em; direction: ltr; font-variant-numeric: tabular-nums; line-height: 1; }
  .hours__dash { opacity: 0.5; }
  @media (max-width: 860px) {
    .wrap { grid-template-columns: 1fr; }
    .who { position: relative; top: 0; max-width: 22rem; margin-inline: auto; }
    .stack__item { position: relative; top: 0; }
  }
</style>
