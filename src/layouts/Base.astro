---
import '../styles/global.css';
import Header from '../components/frame/Header.astro';
import Footer from '../components/frame/Footer.astro';
import { getDictionary, locales, localeUrl, type Locale } from '../i18n';
import { entityGraph } from '../lib/seo';

interface Props {
  lang: Locale;
  path?: string;
  current?: string;
  title?: string;
  description?: string;
  /** 'article' for article pages (adds article:* tags) */
  ogType?: 'website' | 'article';
  /** extra schema.org nodes for this page (breadcrumbs, FAQ, article...) */
  schema?: Record<string, unknown>[];
  published?: string;
}

const { lang, path = '', current = '', title, description, ogType = 'website', schema = [], published } = Astro.props;
const t = getDictionary(lang);
const origin = Astro.site!;
const canonical = new URL(localeUrl(lang, path), origin).href;
const pageTitle = title ? `${title} | SaySmile` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const ogImage = new URL(`${import.meta.env.BASE_URL}og-image.jpg`, origin).href;
const ogLocale = { ru: 'ru_RU', fa: 'fa_IR', en: 'en_US' } as const;
const graph = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...entityGraph(lang, origin), ...schema.map((n) => ({ ...n, inLanguage: lang }))] });
---

<!doctype html>
<html lang={t.htmlLang} dir={t.dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localeUrl(l, path), origin).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localeUrl('ru', path), origin).href} />
    <link rel="alternate" type="text/plain" href={`${import.meta.env.BASE_URL}llms.txt`} title="llms.txt" />

    <meta property="og:site_name" content="SaySmile" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={graph} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <meta name="theme-color" content="#86705e" />

    <!-- Apply saved/system theme before paint (no flash) and enable motion styles -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = 'light';
        try {
          var saved = localStorage.getItem('saysmile-theme');
          theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {}
        root.dataset.theme = theme;
        root.classList.add('js-motion');
        try {
          if (sessionStorage.getItem('saysmile-pt') === '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            sessionStorage.removeItem('saysmile-pt');
            root.classList.add('pt-in');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="pt" aria-hidden="true"><span>Say<b>Smile</b></span></div>
    <a class="sr-only" href="#main">{t.ui.skip}</a>
    <Header lang={lang} path={path} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import { initMotion } from '../scripts/motion';
      import { initThemeToggle } from '../scripts/theme';
      initThemeToggle();
      initMotion();
    </script>
    <script is:inline>
      (function () {
        if (!/^(.*\.)?github\.io$|saysmile/i.test(location.hostname)) return;
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) return; }
          k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
        ym(113992874, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true });
        document.addEventListener('click', function (ev) {
          var a = ev.target.closest && ev.target.closest('a[href]');
          if (!a) return;
          var h = a.getAttribute('href') || '', g = '';
          if (h.indexOf('t.me/') > -1) g = 'click_telegram';
          else if (h.indexOf('wa.me/') > -1) g = 'click_whatsapp';
          else if (h.indexOf('mailto:') === 0) g = 'click_email';
          else if (h.indexOf('tel:') === 0) g = 'click_phone';
          else if (h.indexOf('instagram.com') > -1) g = 'click_instagram';
          if (g) ym(113992874, 'reachGoal', g);
        });
      })();
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/113992874" style="position:absolute;left:-9999px" alt="" /></div></noscript>
  </body>
</html>
