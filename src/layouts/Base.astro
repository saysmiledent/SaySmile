---
import '../styles/global.css';
import Header from '../components/frame/Header.astro';
import Footer from '../components/frame/Footer.astro';
import { getDictionary, locales, localeUrl, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  path?: string;
  current?: string;
  title?: string;
}

const { lang, path = '', current = '', title } = Astro.props;
const t = getDictionary(lang);
const canonical = new URL(localeUrl(lang, path), Astro.site).href;
const pageTitle = title ? `${title} — SaySmile` : t.meta.title;
---

<!doctype html>
<html lang={t.htmlLang} dir={t.dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localeUrl(l, path), Astro.site).href} />
    ))}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="theme-color" content="#86705e" />

    <!-- Apply saved/system theme before paint (no flash) and enable motion styles -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = 'light';
        try {
          var saved = localStorage.getItem('saysmile-theme');
          theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch (e) {}
        root.dataset.theme = theme;
        root.classList.add('js-motion');
      })();
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">{t.ui.skip}</a>
    <Header lang={lang} path={path} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import { initAnimations } from '../scripts/animations';
      import { initThemeToggle } from '../scripts/theme';
      initThemeToggle();
      initAnimations();
    </script>
  </body>
</html>
